VULNARENA_DATABASE_URL=postgresql+asyncpg://vulnarena:change-me@127.0.0.1:5432/vulnarena
# Compose requires a local password; replace this example. Never commit the real .env.
POSTGRES_PASSWORD=change-me
POSTGRES_ADMIN_PASSWORD=change-admin-password
VULNARENA_REDIS_URL=redis://localhost:6379/0
# Optional. Never commit a real key.
VULNARENA_NVD_API_KEY=
VULNARENA_NVD_TIMEOUT=30
VULNARENA_NVD_MAX_RETRIES=3
# Conservative pacing: >=6.1s without key; >=0.61s with key. Default 6.1s for both.
VULNARENA_NVD_INTERVAL=6.1
VULNARENA_TASK_TIMEOUT=300
VULNARENA_LEASE_SECONDS=60
VULNARENA_TASK_TTL=86400
# Empty: loopback-only access. Non-empty: signed admin login at /login.
# Required by compose.yaml. Use a unique long random value, never this file as a secret.
VULNARENA_ADMIN_TOKEN=
VULNARENA_CACHE_TTL=60
# Optional local CPU/CUDA translation; run scripts/setup_translation.py and install .[translation].
VULNARENA_TRANSLATION_MODEL=data/models/translate-en_zh-1_9
# Experimental unauthenticated translation endpoint; disabled by default.
VULNARENA_ONLINE_TRANSLATION=false

# NVD AI only. Blank key/base/model falls back to existing DeepSeek settings.
# Explicit generation sends your question and public vulnerability excerpts to this model.
VULNARENA_AI_API_KEY=
VULNARENA_AI_BASE_URL=
VULNARENA_AI_MODEL=
VULNARENA_AI_DAILY_CALLS=30
VULNARENA_AI_TIMEOUT=75
VULNARENA_AI_MAX_OUTPUT_TOKENS=2200
VULNARENA_AI_EMBEDDING_PYTHON=.tools/ai-runtime/Scripts/python.exe
VULNARENA_AI_EMBEDDING_DIRECTORY=data/models/nvd-e5-small-int8
VULNARENA_AI_EMBEDDING_THREADS=2
VULNARENA_AI_INDEX_PAUSE=0.25
VULNARENA_AI_MIN_SIMILARITY=0.80
VULNARENA_AI_RESUME_JOBS=true
VULNARENA_AI_TRUST_ENV=false
# Optional reference prices per million tokens; unset means unknown, not free.
# VULNARENA_AI_INPUT_PRICE_PER_MILLION=0.30
# VULNARENA_AI_OUTPUT_PRICE_PER_MILLION=1.20
VULNARENA_AI_PRICE_CURRENCY=USD
VULNARENA_AI_PRICE_NOTE=按配置参考单价估算，不代表供应商账单。
